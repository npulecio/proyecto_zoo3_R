@online{ChestnutwingedChachalacaEBird,
  title = {Chestnut-winged Chachalaca - eBird},
  url = {https://ebird.org/species/chwcha1},
  urldate = {2026-09-26},
  abstract = {Chachalaca de cola larga, parecida a una gallina, restringida a las tierras bajas del norte de Colombia. Sus parches alares rufos generalmente permanecen ocultos cuando está posada. Se diferencia de la similar Rufous-vented Chachalaca (Ortalis ruficauda) por su vientre blanco y las puntas de la cola pálidas (no marrón-rojizo). Se diferencia de Colombian Chachalaca (Ortalis columbiana) porque carece de “escamas” en la cabeza y en el pecho. Habita en áreas con bosques ralos así como en manglares. Es más fácil de ver temprano por la mañana o al finalizar la tarde cuando se posa en áreas abiertas desde donde emite sus fuertes y estridentes llamados.},
  langid = {spanish}
}

